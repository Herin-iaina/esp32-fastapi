# Smartelia API Configuration
# Copy this file to .env and adjust values as needed.

# Application Settings
APP_APP_NAME="Smartelia API"
APP_ENVIRONMENT=dev  # Options: dev, staging, prod
APP_LOG_LEVEL=INFO   # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
APP_ENABLE_DOCS=True

# Security
# MUST be at least 32 characters long
APP_SECRET_KEY=change_this_to_a_secure_ramdom_string_min_32_chars
APP_ACCESS_TOKEN_EXPIRES_MINUTES=30
APP_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000"]'

# Database
# Format: postgresql://user:password@host:port/dbname
APP_DATABASE_URL=postgresql://user:password@db:5432/smartelia_db
APP_DATABASE_POOL_SIZE=5
APP_DATABASE_POOL_OVERFLOW=10

# Rate Limiting
APP_RATE_LIMIT_ENABLED=False
APP_RATE_LIMIT_REQUESTS=100
APP_RATE_LIMIT_WINDOW=60

# Admin User
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change_me_in_production
